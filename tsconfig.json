{
  "compilerOptions": {
    "target": "ES2022", "useDefineForClassFields": true,
    "module": "ESNext", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true, "types": ["vite/client", "node"],
    "moduleResolution": "Bundler", "allowImportingTsExtensions": true,
    "resolveJsonModule": true, "isolatedModules": true,
    "noEmit": true, "strict": true
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "tests/**/*.ts", "*.config.ts"]
}
